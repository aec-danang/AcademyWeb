# Copy to .env and fill in. Never commit the real .env.

# --- Database (required) -------------------------------------------------
# Neon pooled connection string. DATABASE_URL is used as a fallback.
NEON_DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL=""

# --- Auth (required) -----------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Media storage: Cloudinary (required for uploads) --------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- AI: hosted (optional) -----------------------------------------------
# When set, writing grading defaults to OpenAI.
OPENAI_API_KEY=""
# OPENAI_GRADING_MODEL="gpt-5.4-mini"
# OPENAI_TEST_BUILDER_MODEL="gpt-5.4-mini"
# "hosted" uses OpenAI for test-builder suggestions; anything else uses the local model.
# TEST_BUILDER_AI_PROVIDER="hosted"

# --- AI: local / Ollama-compatible (optional) ----------------------------
# LOCAL_AI_BASE_URL="http://127.0.0.1:11434"
# LOCAL_AI_MODEL="qwen3.5:9b"
# LOCAL_AI_API_KEY=""

# --- Writing grader (optional) -------------------------------------------
# "openai" | "ollama" (alias "local") | "legacy-local". Defaults to openai if OPENAI_API_KEY is set, else ollama.
# WRITING_GRADING_PROVIDER=""
# Required only when WRITING_GRADING_PROVIDER="legacy-local".
# WRITING_LOCAL_GRADER_URL=""
